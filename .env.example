# Backend API base URL
# Preferred for Vite builds. The app reads env in this order:
# VITE_API_URL (preferred) > NEXT_PUBLIC_API_URL > REACT_APP_API_URL.
# Normally set only VITE_API_URL. Use the alternates only when reusing
# legacy env from Next.js (NEXT_PUBLIC_*) or CRA (REACT_APP_*).

# Recommended
VITE_API_URL=http://127.0.0.1:5057

# Alternates (legacy; commented by default)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5057
# REACT_APP_API_URL=http://127.0.0.1:5057

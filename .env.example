# API base URL for the backend
# For Vite, prefer VITE_API_URL. REACT_APP_API_URL is also supported as a fallback.
# Examples:
# VITE_API_URL=http://localhost:5057
# REACT_APP_API_URL=http://localhost:5057

# Uncomment and set one of the following as needed:
VITE_API_URL=http://localhost:5057
REACT_APP_API_URL=http://localhost:5057
